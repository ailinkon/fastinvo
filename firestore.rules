rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && (
        request.auth.token.email == "linkonashrafulislam@gmail.com" ||
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid ||
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerEmail == request.auth.token.email
      );
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceOwner(workspaceId);
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow write: if isWorkspaceOwner(workspaceId) || (isSignedIn() && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)));

      // Staff subcollection
      match /staff/{staffId} {
        // Staff can read their own profile; Admin can read all staff
        allow read: if isWorkspaceAdmin(workspaceId) ||
          (isSignedIn() && resource.data.googleUid == request.auth.uid) ||
          (isSignedIn() && resource.data.googleEmail == request.auth.token.email);

        // Admin can create/invite staff and set pinHash even before first login
        allow create: if isWorkspaceAdmin(workspaceId);

        // Staff can update their own pinHash or claim invite; Admin can update everything
        allow update: if isWorkspaceAdmin(workspaceId) || (
          isSignedIn() && (
            // Claiming invite on first Google login
            (resource.data.googleUid == null && resource.data.googleEmail == request.auth.token.email) ||
            // Updating own profile / PIN hash
            (resource.data.googleUid == request.auth.uid)
          )
        );

        // Only admin can remove a staff member
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        // Deletions locked strictly to admin
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Clients subcollection
      match /clients/{clientId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Items subcollection
      match /savedItems/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isWorkspaceAdmin(workspaceId);
      }
    }
  }
}
